  "rooms": [
    {
      "code": "DSH-01",
      "name": "High-Gain Dish",
      "deck": "Fwd",
      "color": "#8fe8f5",
      "view": [0.8, 0.5, 0.8],
      "dist": 30,
      "radius": 3,
      "description": "A 10.4 m mesh dish on a three-legged feed, pointed at whichever relay is closest. It carries 40 Mb/s at one astronomical unit and eleven at four, which is why the probe spends half of every day recording and the other half talking. The dish doubles as the sunshade for the instrument bus during an inner-system pass.",
      "stats": [
        ["Aperture", "10.4 m"],
        ["Downlink", "40 Mb/s at 1 AU"],
        ["Feed", "Three-leg"],
        ["Secondary Use", "Sunshade"]
      ],
      "links": [
        {
          "label": "Carries",
          "room": "INS-03"
        }
      ]
    },
    {
      "code": "BUS-02",
      "name": "Avionics Bus",
      "deck": "Bus",
      "color": "#c9b8ff",
      "view": [0.2, 0.8, 0.8],
      "dist": 26,
      "radius": 2.6,
      "description": "Three flight computers voting two from three, 40 TB of recorder and the reaction wheels, all inside a box the size of a wardrobe. It holds attitude to 0.4 arcseconds without thrusters and flies the whole mission from a script when the light lag runs past twenty minutes. Its own heat leaves through the blue radiator face on top.",
      "stats": [
        ["Computers", "3, voting"],
        ["Recorder", "40 TB"],
        ["Pointing", "0.4″"],
        ["Autonomy", "Full script"]
      ],
      "links": [
        {
          "label": "Runs",
          "room": "INS-03"
        },
        {
          "label": "Powered by",
          "room": "PWR-04"
        }
      ]
    },
    {
      "code": "INS-03",
      "name": "Instrument Deck",
      "deck": "Bus",
      "color": "#8fe8f5",
      "view": [0.3, 0.2, 1],
      "dist": 24,
      "radius": 2.6,
      "description": "Three camera tubes, an imaging spectrometer, a dust counter and two star trackers on one thermally isolated plate. The plate is held at 180 K by its own loop so the optics do not drift while the rest of the probe swings between sunlight and shadow. Everything here was calibrated against the same star field before launch and is re-checked every ninety days.",
      "stats": [
        ["Cameras", "3"],
        ["Spectrometer", "0.4–5 µm"],
        ["Plate Temp", "180 K"],
        ["Recalibration", "90 days"]
      ]
    },
    {
      "code": "SAI-05",
      "name": "Solar Sail",
      "deck": "Sail",
      "color": "#ffb070",
      "view": [-0.2, 0.7, 1],
      "dist": 62,
      "radius": 5,
      "description": "Four quadrants of 2 µm aluminised film on 30 m spars, 1,900 m² in all. At one astronomical unit it pushes with about 16 millinewtons, which sounds like nothing and adds up to 500 m/s a year. Tacking the sail is how the probe changes orbit; the thrusters exist only to point it.",
      "stats": [
        ["Area", "1,900 m²"],
        ["Film", "2 µm aluminised"],
        ["Thrust at 1 AU", "16 mN"],
        ["Δv Per Year", "500 m/s"]
      ],
      "links": [
        {
          "label": "Trimmed by",
          "room": "BUS-02"
        }
      ]
    },
    {
      "code": "PWR-04",
      "name": "Radioisotope Generators",
      "deck": "Aft",
      "color": "#ffb070",
      "view": [-0.4, 0.4, 1],
      "dist": 28,
      "radius": 2.6,
      "description": "Two generators on 5 m arms, 640 W between them at launch and falling about 1.6% a year. The arms hold them clear of the instruments, which care about both the heat and the neutrons. Everything aboard is sized against the end-of-mission figure rather than the launch figure, so the probe will still work at year eighteen.",
      "stats": [
        ["Output", "640 W at launch"],
        ["Decay", "1.6% per year"],
        ["Arms", "2 × 5 m"],
        ["Design Life", "18 years"]
      ],
      "links": [
        {
          "label": "Feeds",
          "room": "BUS-02"
        }
      ]
    },
    {
      "code": "BOM-06",
      "name": "Magnetometer Boom",
      "deck": "Aft",
      "color": "#8fe8f5",
      "view": [-0.9, 0.4, 0.6],
      "dist": 30,
      "radius": 2.6,
      "description": "A 22 m boom that puts the magnetometer far enough from the probe to read the field rather than the spacecraft. Even at that distance the team subtract a model of the probe's own signature from every reading. The boom unrolled once, eleven minutes after separation, and cannot be retracted.",
      "stats": [
        ["Length", "22 m"],
        ["Sensors", "2 fluxgate"],
        ["Deployment", "Once, irreversible"],
        ["Noise Floor", "4 pT"]
      ]
    }
  ],
