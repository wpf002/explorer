        ["Seats", "1 + 1 jump"],
        ["Glazing", "Front, sides, roof"],
        ["Controllers", "2 hand · 1 foot bar"],
        ["Work Lights", "4"]
      ],
      "links": [
        {
          "label": "Flies",
          "room": "GRP-01"
        }
      ],
      "hotspots": [
        {
          "pos": [15, 0.8, 0],
          "title": "Pilot Seat",
          "text": "Rotates 180° so the pilot can fly the arms facing aft."
        },
        {
          "pos": [17.4, 0.6, 0],
          "title": "Wrap Console",
          "text": "Arm telemetry on the left, ship on the right, tow load in the middle."
        },
        {
          "pos": [16.4, 3.1, 0],
          "title": "Roof Panel",
          "text": "The window that matters when the tug is under a station keel."
        }
      ]
    },
    {
      "code": "CRW-02",
      "name": "Bunkroom",
      "deck": "Cab",
      "color": "#8fe8f5",
      "view": [0.2, 0.4, -1],
      "dist": 16,
      "radius": 1.4,
      "close": {
        "pos": [8.4, 0.4, 2.2],
        "look": [12.4, 0.2, -1.2]
      },
      "description": "Four bunks for a crew of three, which is two on shift and one asleep with a spare rack for a yard hand riding along. A kettle, a locker each and a table that folds off the bulkhead. Tug crews work eleven-hour shifts and rarely spend more than four days aboard before returning to the station.",
      "stats": [
        ["Bunks", "4"],
        ["Crew", "3"],
        ["Shift", "11 h"],
        ["Endurance", "9 days"]
      ],
      "hotspots": [
        {
          "pos": [11.4, 0.2, 2],
          "title": "Bunk",
          "text": "Two tiers, two deep. The fourth rack is for a yard hand."
        }
      ]
    },
    {
      "code": "EVA-04",
      "name": "Work Airlock",
      "deck": "Cab",
      "color": "#8fe8f5",
      "view": [0.2, -0.8, 0.6],
      "dist": 16,
      "radius": 1.4,
      "close": {
        "pos": [11, -2.4, 2.6],
        "look": [11, -4.6, -0.6]
      },
      "description": "A ventral lock under the cab, straight out onto the job. Two suits hang either side of the inner hatch and the tool caddy clips to the rim outside. It cycles in thirty seconds, which matters when the crew go out four or five times a shift to set a clamp by hand.",
      "stats": [
        ["Cycle", "30 s"],
        ["Suits", "2"],
        ["Cycles Per Shift", "4–5 typical"],
        ["Tool Caddy", "External rim"]
      ]
    },
    {
      "code": "GRP-01",
      "name": "Grapple Arms",
      "deck": "Work",
      "color": "#f0b64a",
      "view": [0.9, 0.4, 0.7],
      "dist": 22,
      "radius": 2,
      "description": "Four seven-metre arms on a rotating collar, each with a three-jaw end effector and a load cell in the wrist. Any two arms can hold 400 t of stationary mass; all four together can hold 900 t and still have a hand free to fend off. The arms are flown one at a time from the cab, or run on a rehearsed script for a routine berthing.",
      "stats": [
        ["Arms", "4 × 7 m"],
        ["Hold", "900 t all four"],
        ["End Effector", "Three-jaw"],
        ["Modes", "Manual · scripted"]
      ],
      "links": [
        {
          "label": "Flown from",
          "room": "BRG-01"
        }
      ],
      "hotspots": [
        {
          "pos": [28, 3.4, 0],
          "title": "End Effector",
          "text": "Three jaws and a load cell; it reads the mass before it takes the weight."
        }
      ]
    },
    {
      "code": "TOW-05",
      "name": "Tow Winch",
      "deck": "Work",
      "color": "#ffb070",
      "view": [0.3, 0.9, 0.6],
      "dist": 18,
      "radius": 1.6,
      "description": "A 900 m composite cable on a dorsal drum, for the jobs too big to grapple. The tug takes up the slack at 2 cm/s and then pulls with the drives while the winch holds the angle. The drum pays out under load if the tension passes 60 kN, which is what keeps a bad pull from folding the truss.",
      "stats": [
        ["Cable", "900 m"],
        ["Pull", "60 kN limit"],
        ["Take-up", "2 cm/s"],
        ["Release", "Automatic over-tension"]
      ]
    },
    {
      "code": "TNK-02",
      "name": "Propellant Tanks",
      "deck": "Eng",
      "color": "#8fe8f5",
      "view": [0.2, 0.3, 1],
      "dist": 22,
      "radius": 2,
      "description": "Four spheres on the open truss: two large forward, two small aft, 31 tonnes of propellant in total. They are outside the hull because a tug refills every other day and nobody wants to open a hull to do it. Each sphere isolates on its own valve, so a puncture costs a quarter of the load and not the job.",
      "stats": [
        ["Spheres", "4"],
        ["Propellant", "31 t"],
        ["Refill", "Every 2 days typical"],
        ["Isolation", "Per sphere"]
      ]
    },
    {
      "code": "DRV-03",
      "name": "Drive Bells",
      "deck": "Eng",
      "color": "#ffb070",
      "view": [-1, 0.4, 0.6],
      "dist": 24,
      "radius": 2,
      "description": "Two oversized bells on a 44 m hull, because a tug is judged by what it can move rather than how fast it goes. Together they make 220 kN, enough to give an empty tug 1.4 g or a 900 t tow a slow, steady push. They throttle down to 3% for the last centimetres of a berthing.",
      "stats": [
        ["Bells", "2"],
        ["Thrust", "220 kN"],
        ["Empty Acceleration", "1.4 g"],
        ["Minimum Throttle", "3%"]
      ],
      "links": [
        {
          "label": "Fed by",
          "room": "TNK-02"
        }
      ]
    }
  ],
