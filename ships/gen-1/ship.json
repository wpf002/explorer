  "rooms": [
    {
      "code": "SHD-01",
      "name": "Ice Shield",
      "deck": "Fwd",
      "color": "#8fe8f5",
      "view": [1, 0.4, 0.6],
      "dist": 300,
      "radius": 22,
      "description": "A 124 m disc of dirty water ice, fourteen metres thick, carried ahead of everything else. At cruise the ship meets interstellar dust at a fifth of light speed, and the shield is simply mass in the way: it ablates about nine metres a century and is topped up from cometary material at every waypoint. Behind it the hull is cold and quiet.",
      "stats": [
        ["Diameter", "124 m"],
        ["Thickness", "14 m"],
        ["Ablation", "9 m per century"],
        ["Replenished", "At waypoints"]
      ],
      "links": [
        {
          "label": "Tops up from",
          "room": "IND-01"
        }
      ]
    },
    {
      "code": "CMD-02",
      "name": "Bridge",
      "deck": "Fwd",
      "color": "#8fe8f5",
      "view": [0.7, -0.5, 0.8],
      "dist": 140,
      "radius": 14,
      "description": "Six stations in a blister under the shield, with the only forward-facing window on the ship. It is manned at one station for most of the voyage; the other five are for waypoint approaches and for the century-long deceleration. The ship's course is a document, not a decision, and the watch exists to notice the year something goes wrong with it.",
      "stats": [
        ["Stations", "6"],
        ["Routine Watch", "1"],
        ["Window", "20 m"],
        ["Course Authority", "Standing plan"]
      ]
    },
    {
      "code": "DCK-03",
      "name": "Shuttle Bays",
      "deck": "Fwd",
      "color": "#f0b64a",
      "view": [0.5, 0.3, 1],
      "dist": 170,
      "radius": 16,
      "description": "Two bays either side of the forward spine, each holding four small craft behind a field curtain. They are used at waypoints to mine ice and ore, and for the survey work that pays for the stop. Between waypoints the craft sit powered down for decades, and their crews are people who have never flown anything else.",
      "stats": [
        ["Bays", "2"],
        ["Craft", "8"],
        ["Curtain", "42 × 12 m"],
        ["Duty Cycle", "Waypoints only"]
      ],
      "links": [
        {
          "label": "Craft type",
          "ship": "tw-2"
        },
        {
          "label": "Lander",
          "ship": "ldr-5"
        }
      ],
      "hotspots": [
        {
          "pos": [500, 0, 30],
          "title": "Bay Floor",
          "text": "Marked lanes to the curtain; the deck has not been repainted since departure."
        }
      ]
    },
    {
      "code": "RGA-01",
      "name": "Ring A · Townships",
      "deck": "Ring",
      "color": "#8fe8f5",
      "view": "radial",
      "dist": 300,
      "radius": 20,
      "description": "Forty-eight townships around a 236 m ring turning at 2.7 rpm for 0.95 g. Each township is about 130 people: dwellings on the outer wall, workshops and schools on the inner. Ring A holds the older half of the population and the ship's two oldest institutions, the assembly and the court, both of which predate the voyage by a decade.",
      "stats": [
        ["Diameter", "236 m"],
        ["Spin", "2.7 rpm"],
        ["Rim Gravity", "0.95 g"],
        ["Population", "6,200"]
      ],
      "links": [
        {
          "label": "Counter-rotates against",
          "room": "RGB-01"
        }
      ]
    },
    {
      "code": "RGA-05",
      "name": "Ring A · Commons",
      "deck": "Ring",
      "color": "#ff5c7a",
      "view": "radial",
      "dist": 260,
      "radius": 18,
      "description": "Six townships' worth of ring given over to parkland under a glazed roof, the only place aboard where the horizon curves up instead of ending at a bulkhead. Trees are on their fourth generation and are pruned to a nine-metre limit. The commons is also where the ship holds its assembly, which is the closest thing the voyage has to weather.",
      "stats": [
        ["Length", "31 m of rim"],
        ["Canopy", "Glazed, 9 m"],
        ["Trees", "4th generation"],
        ["Doubles As", "Assembly floor"]
      ]
    },
    {
      "code": "RGB-01",
      "name": "Ring B · Townships",
      "deck": "Ring",
      "color": "#8fe8f5",
      "view": "radial",
      "dist": 300,
      "radius": 20,
      "description": "The second ring, turning the other way so the ship as a whole holds no net spin. Ring B was fitted out eighty years after departure and is built to a later standard: wider passages, bigger windows and a plumbing layout that the people in Ring A still complain about. It holds the younger half of the population.",
      "stats": [
        ["Diameter", "236 m"],
        ["Spin", "2.7 rpm, reversed"],
        ["Population", "6,200"],
        ["Fitted Out", "Year 80"]
      ],
      "links": [
        {
          "label": "Counter-rotates against",
          "room": "RGA-01"
        }
      ]
    },
    {
      "code": "FRM-01",
      "name": "Farm Drum One",
      "deck": "Spine",
      "color": "#ff5c7a",
      "view": [0.3, 0.7, 1],
      "dist": 180,
      "radius": 16,
      "close": {
        "pos": [38, 0, 0],
        "look": [-20, 10, 6]
      },
      "description": "A 92 m drum turning at 3.4 rpm for 0.4 g at the wall, stacked with terraces under tuned lamps. It grows the grain and the oil crops: about two thirds of the ship's calories, with the rest from the second drum and the ring gardens. A drum can be sealed and sterilised in eleven hours, which has been necessary twice.",
      "stats": [
        ["Length", "92 m"],
        ["Wall Gravity", "0.4 g"],
        ["Calorie Share", "44%"],
        ["Sterilisation", "11 h"]
      ],
      "links": [
        {
          "label": "Paired with",
          "room": "FRM-02"
        }
      ],
      "hotspots": [
        {
          "pos": [0, 26, 0],
          "title": "Terrace",
          "text": "Three tiers per segment, harvested on a rolling 40-day cycle."
        },
        {
          "pos": [0, 21.5, 0],
          "title": "Lamp Bank",
          "text": "Tuned to the crop, not to daylight. The drums never go dark together."
        }
      ]
    },
    {
      "code": "FRM-02",
      "name": "Farm Drum Two",
      "deck": "Spine",
      "color": "#ff5c7a",
      "view": [-0.3, 0.7, 1],
      "dist": 180,
      "radius": 16,
      "description": "The second drum, counter-rotating, given to vegetables, protein culture and the fish tanks that sit along its axis where the gravity is lowest. It is deliberately not identical to the first: different lamp spectra, different water loop, different failure modes. No blight that takes one drum has yet been able to take both.",
      "stats": [
        ["Length", "92 m"],
        ["Fish Tanks", "Axial, 0.1 g"],
        ["Calorie Share", "38%"],
        ["Design", "Deliberately unlike FRM-01"]
      ],
      "links": [
        {
          "label": "Paired with",
          "room": "FRM-01"
        }
      ]
    },
    {
      "code": "IND-01",
      "name": "Foundry & Shops",
      "deck": "Spine",
      "color": "#ffb070",
      "view": [0.2, 0.6, 1],
      "dist": 150,
      "radius": 15,
      "description": "The ship's ability to make things rather than carry them: an induction foundry, five machine halls and a printer floor, all in a 70 m box amidships. Everything from ring plating to teeth comes out of here. The furnace has been cold twice in eleven hundred years, and both occasions have names.",
      "stats": [
        ["Halls", "5"],
        ["Furnace", "Induction, 40 t"],
        ["Feedstock", "Waypoint ore · recycling"],
        ["Cold Since Departure", "Twice"]
      ],
      "links": [
        {
          "label": "Supplies",
          "room": "SHD-01"
        }
      ]
    },
    {
      "code": "MED-01",
      "name": "Infirmary",
      "deck": "Spine",
      "color": "#8fe8f5",
      "view": [0.3, 0.8, 0.6],
      "dist": 130,
      "radius": 13,
      "description": "Four surgical suites and a 60-bed ward on the spine, at a tenth of a gravity, which suits surgery and nothing else. Routine care happens in the rings; this is where the ship sends what the townships cannot handle. The genetic registry sits behind the same door, because on a closed voyage medicine and ancestry are the same profession.",
      "stats": [
        ["Suites", "4"],
        ["Beds", "60"],
        ["Gravity", "0.1 g"],
        ["Also Holds", "Genetic registry"]
      ]
    },
    {
      "code": "ARC-01",
      "name": "Seed Vault & Archive",
      "deck": "Spine",
      "color": "#c9b8ff",
      "view": [-0.3, -0.7, 0.8],
      "dist": 130,
      "radius": 13,
      "description": "Six shielded stacks at 90 K holding 1.4 million seed lines and the written record of the voyage, etched rather than stored, because nothing electronic aboard is expected to outlive the trip. The archive is opened on a schedule: every line is germinated and re-banked on a two-hundred-year rotation, and every record is read aloud once.",
      "stats": [
        ["Seed Lines", "1.4 million"],
        ["Temperature", "90 K"],
        ["Record", "Etched nickel"],
        ["Rotation", "200 years"]
      ]
    },
    {
      "code": "RCT-01",
      "name": "Reactor Hall",
      "deck": "Eng",
      "color": "#ffb070",
      "view": [-0.5, 0.5, 1],
      "dist": 200,
      "radius": 18,
      "description": "Three fusion tori in a 90 m hall, two running and one stripped at any time. Total output is 42 GW: the drives take most of it under way, the rings and drums take the rest. The hall is designed to be rebuilt in place, one torus at a time, which is the only way a plant survives eleven centuries.",
      "stats": [
        ["Tori", "3, two running"],
        ["Output", "42 GW"],
        ["Overhaul", "One torus at a time"],
        ["Hall", "90 m"]
      ],
      "links": [
        {
          "label": "Feeds",
          "room": "DRV-01"
        },
        {
          "label": "Heat to",
          "room": "RAD-02"
        }
      ]
    },
    {
      "code": "RAD-02",
      "name": "Radiator Banks",
      "deck": "Eng",
      "color": "#ff5c7a",
      "view": [-0.2, 1, 0.5],
      "dist": 260,
      "radius": 18,
      "description": "Six 120 m panels along the aft spine, angled off the plane so the rings never see them. They reject 26 GW of waste heat, which is most of what the reactors make and all of what the farms and the foundry throw off. Panels are replaced on a rolling schedule; two of the six are always younger than fifty years.",
      "stats": [
        ["Panels", "6 × 120 m"],
        ["Rejection", "26 GW"],
        ["Coolant", "Liquid tin"],
        ["Replacement", "Rolling"]
      ],
      "links": [
